{
  "name": "pehchaan-travels",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n db,web -c blue,green \"npm run db:dev\" \"npm run dev:web\"",
    "dev:web": "wait-on tcp:51214 && next dev",
    "db:dev": "prisma dev --detach",
    "build": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "jose": "^6.2.8",
    "next": "^15.5.0",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "wait-on": "^9.1.0"
  }
}
