generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id              String              @id @default(cuid()) @map("_id")
  email           String              @unique
  passwordHash    String
  name            String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  resetTokens     PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid()) @map("_id")
  token     String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id               String        @id @default(cuid()) @map("_id")
  name             String
  slug             String        @unique
  description      String?
  shortDescription String?
  longDescription  String?
  type             String        @default("DESTINATION")
  published        Boolean       @default(true)
  image            String?
  orderNumber      Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  destinations     Destination[]
  hotels           Hotel[]
  tours            Tour[]
}

model Tour {
  id               String            @id @default(cuid()) @map("_id")
  slug             String            @unique
  name             String
  shortDescription String
  fullDescription  String
  destination      String
  location         String?
  price            Float
  duration         String
  days             Int
  startDate        String?
  startTime        String?
  endDate          String?
  endTime          String?
  meetingPoint     String?
  itinerary        Json?
  faqs             Json?
  includedServices String[]
  excludedServices String[]
  maxGuests        Int?
  rating           Float             @default(0)
  bannerImage      String
  published        Boolean           @default(true)
  featured         Boolean           @default(false)
  latest           Boolean           @default(false)
  categoryId       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  category         Category?         @relation(fields: [categoryId], references: [id])
  images           TourImage[]
  reviews          Review[]
  destinationTours DestinationTour[]
}

model TourImage {
  id     String  @id @default(cuid()) @map("_id")
  url    String
  alt    String?
  order  Int     @default(0)
  tourId String
  tour   Tour    @relation(fields: [tourId], references: [id])
}

model Hotel {
  id               String             @id @default(cuid()) @map("_id")
  slug             String             @unique
  name             String
  shortDescription String?
  fullDescription  String?
  description      String
  location         String
  address          String?
  pricePerNight    Float
  rating           Float              @default(0)
  contactPhone     String?
  contactEmail     String?
  checkInTime      String?
  checkOutTime     String?
  amenities        String[]
  roomTypes        Json?
  bannerImage      String
  published        Boolean            @default(true)
  featured         Boolean            @default(false)
  categoryId       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  category         Category?          @relation(fields: [categoryId], references: [id])
  images           HotelImage[]
  destinationHotels DestinationHotel[]
}

model HotelImage {
  id      String  @id @default(cuid()) @map("_id")
  url     String
  alt     String?
  order   Int     @default(0)
  hotelId String
  hotel   Hotel   @relation(fields: [hotelId], references: [id])
}

model Destination {
  id               String             @id @default(cuid()) @map("_id")
  slug             String             @unique
  name             String
  shortDescription String?
  fullDescription  String?
  description      String
  location         String
  image            String
  published        Boolean            @default(true)
  featured         Boolean            @default(false)
  orderNumber      Int                @default(0)
  categoryId       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  category         Category?          @relation(fields: [categoryId], references: [id])
  hotels           DestinationHotel[]
  tours            DestinationTour[]
}

model DestinationTour {
  id            String      @id @default(cuid()) @map("_id")
  destinationId String
  tourId        String
  destination   Destination @relation(fields: [destinationId], references: [id])
  tour          Tour        @relation(fields: [tourId], references: [id])

  @@unique([destinationId, tourId])
}

model DestinationHotel {
  id            String      @id @default(cuid()) @map("_id")
  destinationId String
  hotelId       String
  destination   Destination @relation(fields: [destinationId], references: [id])
  hotel         Hotel       @relation(fields: [hotelId], references: [id])

  @@unique([destinationId, hotelId])
}

model Testimonial {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  text      String
  rating    Int      @default(5)
  avatar    String?
  published Boolean  @default(true)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TripRequest {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  email       String
  phone       String
  destination String
  travelers   Int
  startDate   String
  endDate     String
  budget      String?
  message     String?
  status      String   @default("PENDING")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id              String                @id @default(cuid()) @map("_id")
  fullName        String
  email           String                @unique
  phone           String                @unique
  passwordHash    String
  avatar          String?
  blocked         Boolean               @default(false)
  createdAt       DateTime              @default(now())
  resetTokens     UserPasswordResetToken[]
  reviews         Review[]
}

model UserPasswordResetToken {
  id        String   @id @default(cuid()) @map("_id")
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id            String      @id @default(cuid()) @map("_id")
  fullName      String
  email         String
  phone         String
  address       String?
  city          String?
  notes         String?
  totalAmount   Float
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
  items         OrderItem[]
  transactions  Transaction[]
  reviews       Review[]
}

model OrderItem {
  id        String  @id @default(cuid()) @map("_id")
  tourId    String
  tourName  String
  tourImage String?
  price     Float
  quantity  Int
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
}

model Transaction {
  id            String   @id @default(cuid()) @map("_id")
  orderId       String?
  tracker       String?
  customerName  String
  customerEmail String
  amount        Int
  status        String   @default("Pending")
  method        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order?   @relation(fields: [orderId], references: [id])
}

model NewsletterSubscriber {
  id              String    @id @default(cuid()) @map("_id")
  email           String    @unique
  status          String    @default("active")
  subscribedAt    DateTime  @default(now())
  unsubscribedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Newsletter {
  id              String    @id @default(cuid()) @map("_id")
  subject         String
  title           String
  content         String
  image           String?
  ctaText         String?
  ctaUrl          String?
  status          String    @default("draft")
  sentAt          DateTime?
  recipientCount  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Review {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  orderId       String?
  tourId        String
  rating        Float
  comment       String
  images        String[]
  status        String   @default("pending")
  adminResponse String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
  order         Order?   @relation(fields: [orderId], references: [id])
  tour          Tour     @relation(fields: [tourId], references: [id])

  @@unique([userId, tourId])
}
