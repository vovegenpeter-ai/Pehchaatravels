generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id              String              @id @default(cuid())
  email           String              @unique
  passwordHash    String
  name            String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  resetTokens     PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([adminId])
}

model Category {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  type         CategoryType
  published    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  destinations Destination[]
  hotels       Hotel[]
  tours        Tour[]
}

model Tour {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  shortDescription String
  fullDescription  String
  destination      String
  location         String?
  price            Decimal           @db.Decimal(10, 2)
  duration         String
  days             Int
  startDate        String?
  startTime        String?
  endDate          String?
  endTime          String?
  meetingPoint     String?
  itinerary        Json?
  includedServices String[]          @default([])
  excludedServices String[]          @default([])
  maxGuests        Int?
  rating           Float             @default(0)
  bannerImage      String
  published        Boolean           @default(true)
  featured         Boolean           @default(false)
  popular          Boolean           @default(false)
  latest           Boolean           @default(false)
  categoryId       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  destinations     DestinationTour[]
  category         Category?         @relation(fields: [categoryId], references: [id])
  images           TourImage[]
  reviews          Review[]
}

model TourImage {
  id     String  @id @default(cuid())
  url    String
  alt    String?
  order  Int     @default(0)
  tourId String
  tour   Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Hotel {
  id               String             @id @default(cuid())
  slug             String             @unique
  name             String
  shortDescription String?
  fullDescription  String?
  description      String
  location         String
  address          String?
  pricePerNight    Decimal            @db.Decimal(10, 2)
  rating           Float              @default(0)
  contactPhone     String?
  contactEmail     String?
  checkInTime      String?
  checkOutTime     String?
  amenities        String[]           @default([])
  roomTypes        Json?
  bannerImage      String
  published        Boolean            @default(true)
  featured         Boolean            @default(false)
  categoryId       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  destinations     DestinationHotel[]
  category         Category?          @relation(fields: [categoryId], references: [id])
  images           HotelImage[]
}

model HotelImage {
  id      String  @id @default(cuid())
  url     String
  alt     String?
  order   Int     @default(0)
  hotelId String
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Destination {
  id               String             @id @default(cuid())
  slug             String             @unique
  name             String
  shortDescription String?
  fullDescription  String?
  description      String
  location         String
  image            String
  published        Boolean            @default(true)
  featured         Boolean            @default(false)
  categoryId       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  category         Category?          @relation(fields: [categoryId], references: [id])
  hotels           DestinationHotel[]
  tours            DestinationTour[]
}

model DestinationTour {
  destinationId String
  tourId        String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  tour          Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@id([destinationId, tourId])
}

model DestinationHotel {
  destinationId String
  hotelId       String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  hotel         Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([destinationId, hotelId])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  text      String
  rating    Int      @default(5)
  avatar    String?
  published Boolean  @default(true)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model TripRequest {
  id          String           @id @default(cuid())
  name        String
  email       String
  phone       String
  destination String
  travelers   Int
  startDate   String
  endDate     String
  budget      String?
  message     String?
  status      TripRequestStatus @default(PENDING)
  adminNotes  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum TripRequestStatus {
  PENDING
  CONTACTED
  CONFIRMED
  CANCELLED
}

model User {
  id              String                @id @default(cuid())
  fullName        String
  email           String                @unique
  phone           String                @unique
  passwordHash    String
  avatar          String?
  createdAt       DateTime              @default(now())
  resetTokens     UserPasswordResetToken[]
  reviews         Review[]
}

model UserPasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Order {
  id            String      @id @default(cuid())
  fullName      String
  email         String
  phone         String
  address       String?
  city          String?
  notes         String?
  totalAmount   Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  items         OrderItem[]
  transactions  Transaction[]
  reviews       Review[]
}

model OrderItem {
  id        String  @id @default(cuid())
  tourId    String
  tourName  String
  tourImage String?
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CategoryType {
  TOUR
  HOTEL
  DESTINATION
  ACTIVITY
}

enum TransactionStatus {
  Pending
  Successful
  Failed
  Refunded
}

model Transaction {
  id            String            @id @default(cuid())
  orderId       String?
  tracker       String?
  customerName  String
  customerEmail String
  amount        Int               // amount in PKR
  status        TransactionStatus @default(Pending)
  method        String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  // Relations
  order         Order?            @relation(fields: [orderId], references: [id])

  @@index([tracker])
  @@index([orderId])
}

model NewsletterSubscriber {
  id              String    @id @default(cuid())
  email           String    @unique
  status          String    @default("active") // active, unsubscribed
  subscribedAt    DateTime  @default(now())
  unsubscribedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([status])
}

model Newsletter {
  id              String    @id @default(cuid())
  subject         String
  title           String
  content         String
  image           String?
  ctaText         String?
  ctaUrl          String?
  status          String    @default("draft") // draft, sending, sent, failed
  sentAt          DateTime?
  recipientCount  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([sentAt])
}

model Review {
  id            String   @id @default(cuid())
  userId        String
  orderId       String?
  tourId        String
  rating        Float    // 0.5 - 5.0 (supports half-stars)
  comment       String
  images        String[] @default([])
  status        String   @default("pending") // pending, approved, rejected
  adminResponse String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  tour          Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([userId, tourId]) // One review per user per tour
  @@index([userId])
  @@index([tourId])
  @@index([status])
  @@index([createdAt])
}
