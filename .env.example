# =============================================================================
# DATABASE — Local vs Production separation
# =============================================================================
# The app and Prisma both read DATABASE_URL at runtime. You MUST set
# DATABASE_URL to the correct connection string for each environment:
#
#   Local dev (.env.local or "npm run dev"):
#     DATABASE_URL = mongodb+srv://...local_pehchaan_travels...
#
#   Production (Vercel / hosting platform Environment Variables):
#     DATABASE_URL = mongodb+srv://...prod_pehchaan_travels...
#
# Local and Production MUST use completely separate databases. Never set
# both environments to the same connection string.
#
# The DATABASE_URL_DEV and DATABASE_URL_PROD variables below are
# documentation aliases used by prisma.config.ts (CLI tools: migrate,
# db push, seed). They are NOT read by the Prisma client at runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# Local / Development database (your local machine, "npm run dev")
# -----------------------------------------------------------------------------
DATABASE_URL="mongodb+srv://faisalzia009_db_user:SSn3vT0TFzBKpwnZ@cluster0.ojrl4q5.mongodb.net/local_pehchaan_travels?retryWrites=true&w=majority"
DATABASE_URL_DEV="mongodb+srv://faisalzia009_db_user:SSn3vT0TFzBKpwnZ@cluster0.ojrl4q5.mongodb.net/local_pehchaan_travels?retryWrites=true&w=majority"

# -----------------------------------------------------------------------------
# Production database (set in Vercel → Project Settings → Environment Variables)
#   VARIABLE: DATABASE_URL
#   VALUE:    mongodb+srv://<prod_user>:<prod_password>@<prod_cluster>.mongodb.net/prod_pehchaan_travels?retryWrites=true&w=majority
#   SCOPE:    Production (do NOT set this in Development/Local)
# -----------------------------------------------------------------------------
# DATABASE_URL_PROD="mongodb+srv://<prod_user>:<prod_password>@<prod_cluster>.mongodb.net/prod_pehchaan_travels?retryWrites=true&w=majority"

# =============================================================================
# Cloudinary
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# Next.js
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# Admin
# =============================================================================
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Admin"

# =============================================================================
# SMTP / Email
# =============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="\"Pehchaan Travels\" <your-email@gmail.com>"

# =============================================================================
# JWT Secrets (change these in production!)
# =============================================================================
ADMIN_JWT_SECRET="replace-with-a-random-secret"
USER_JWT_SECRET="replace-with-a-random-secret"
