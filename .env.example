# =============================================================================
# DATABASE — Local vs Production separation
# =============================================================================
# The app and Prisma both read DATABASE_URL at runtime. You MUST set
# DATABASE_URL to the correct connection string for each environment:
#
#   Local dev (.env.local or "npm run dev"):
#     DATABASE_URL = mongodb+srv://...local_pehchaan_travels...
#
#   Production (Vercel / hosting platform Environment Variables):
#     DATABASE_URL = mongodb+srv://...prod_pehchaan_travels...
#
# Local and Production MUST use completely separate databases. Never set
# both environments to the same connection string.
#
# The DATABASE_URL_DEV and DATABASE_URL_PROD variables below are
# documentation aliases used by prisma.config.ts (CLI tools: migrate,
# db push, seed). They are NOT read by the Prisma client at runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# Local / Development database (your local machine, "npm run dev")
# -----------------------------------------------------------------------------
DATABASE_URL="mongodb+srv://..."
DATABASE_URL_DEV="mongodb+srv://..."

# -----------------------------------------------------------------------------
# Production database (set in Vercel → Project Settings → Environment Variables)
#   VARIABLE: DATABASE_URL
#   VALUE:    mongodb+srv://<prod_user>:<prod_password>@<prod_cluster>.mongodb.net/prod_pehchaan_travels?retryWrites=true&w=majority
#   SCOPE:    Production (do NOT set this in Development/Local)
# -----------------------------------------------------------------------------
# DATABASE_URL_PROD="mongodb+srv://<prod_user>:<prod_password>@<prod_cluster>.mongodb.net/prod_pehchaan_travels?retryWrites=true&w=majority"

# =============================================================================
# Cloudinary
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# Next.js
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# Admin
# =============================================================================
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# =============================================================================
# SMTP / Email
# =============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS=""
SMTP_FROM="\"Pehchaan Travels\" <your-email@gmail.com>"

# =============================================================================
# JWT Secrets (change these in production!)
# =============================================================================
ADMIN_JWT_SECRET=""
USER_JWT_SECRET=""

# =============================================================================
# Google reCAPTCHA v2 (Sign Up / Sign In only)
# =============================================================================
# Get keys at https://www.google.com/recaptcha — reCAPTCHA v2 "I'm not a robot".
# Site key is public (exposed to the browser via NEXT_PUBLIC_); secret key is
# server-only. Add BOTH to Vercel production environment variables.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# =============================================================================
# SEO  (see lib/seo.js)
# =============================================================================
# Canonical origin used for <link rel=canonical>, Open Graph URLs, the XML
# sitemap and robots.txt. Set this to the REAL public domain in production.
# Do NOT reuse NEXT_PUBLIC_APP_URL for this — that variable is used for email
# links and currently points at the Vercel deployment URL.
NEXT_PUBLIC_SITE_URL="https://pehchaantravels.pk"

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave empty to disable Analytics entirely (the site loads no GA script).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Search Console ownership verification token (the content= value of the
# <meta name="google-site-verification"> tag). Leave empty until the domain has
# been verified in Search Console.
NEXT_PUBLIC_GSC_VERIFICATION=""

# TikTok Pixel. The site's pixel ID is built into lib/tiktok.js, so this only
# needs to be set to override it (e.g. a separate pixel for staging). The pixel
# is only loaded after a visitor grants analytics consent.
NEXT_PUBLIC_TIKTOK_PIXEL_ID="DC3JSVJC77U703IGKRCG"

# PostHog session replay (optional). Leave both empty to disable: the replay
# controller is a no-op until both are set. The token is the public project
# token from PostHog Project Settings - never a personal API key. Host is
# either https://us.i.posthog.com or https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# =============================================================================
# pokayoke security review (npm run security:review)
# =============================================================================
# Free API key from https://pokayoke.sh (dashboard -> Agents & API). The script
# sends this repo to the pokayoke review API as an archive upload and prints
# each finding as proven, confirmed or unproven. Leave empty to keep it off.
POKAYOKE_API_KEY=

# Meta (Facebook & Instagram) Pixel ID — Meta Events Manager → Data sources.
# Leave empty to disable all Meta tracking.
NEXT_PUBLIC_META_PIXEL_ID=
