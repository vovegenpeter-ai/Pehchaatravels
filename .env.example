# =============================================================
# Pehchaan Travels — environment variables
# Copy this file to .env for local development:
#   cp .env.example .env
# =============================================================

# ---- LOCAL DEVELOPMENT (`.env`) ------------------------------
# Local dev DB started by `npm run dev` (Prisma PGlite instance on port 51214)
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Admin JWT secret (change in production)
ADMIN_JWT_SECRET="change-this-to-a-long-random-secret-key"

# User session JWT secret (optional — falls back to ADMIN_JWT_SECRET)
USER_JWT_SECRET="change-this-to-a-long-random-secret-key"

# Default admin credentials (used by seed script)
ADMIN_EMAIL="admin@pehchaantravels.com"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="Pehchaan Admin"

# App public URL (used for password reset links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- SMTP EMAIL CONFIGURATION (for Password Reset emails) ----
# Works with Gmail (App Passwords), SendGrid, Mailgun, Brevo, Resend SMTP, or custom host
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-or-smtp-key"
SMTP_FROM="\"Pehchaan Travels\" <your-email@gmail.com>"

# ---- PRODUCTION (set these in Vercel Project Settings > Environment Variables) ----
# Use a hosted PostgreSQL database, e.g. Neon, Supabase, or Railway.
# Example (Neon):
# DATABASE_URL="postgresql://user:password@ep-example-123.us-east-2.aws.neon.tech/pehchaan?sslmode=require"
#
# Generate strong secrets, e.g. with: openssl rand -base64 32
# ADMIN_JWT_SECRET="a-long-random-production-secret"
# USER_JWT_SECRET="another-long-random-production-secret"
#
# Credentials the seed script creates for the admin login (change these!)
# ADMIN_EMAIL="admin@pehchaantravels.com"
# ADMIN_PASSWORD="A-Strong-Production-Password"
# ADMIN_NAME="Pehchaan Admin"
#
# SMTP Settings in Vercel:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-gmail-app-password"
# SMTP_FROM="\"Pehchaan Travels\" <your-email@gmail.com>"
# NEXT_PUBLIC_APP_URL="https://pehchaantravels.vercel.app"
