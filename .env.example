# PostgreSQL connection string
# For local dev with Prisma: run `npm run dev` (starts DB + app) or `npm run db:dev` in a separate terminal
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Admin JWT secret (change in production)
ADMIN_JWT_SECRET="change-this-to-a-long-random-secret-key"

# User session JWT secret (optional — falls back to ADMIN_JWT_SECRET)
USER_JWT_SECRET="change-this-to-a-long-random-secret-key"

# Default admin credentials (used by seed script)
ADMIN_EMAIL="admin@pehchaantravels.com"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="Pehchaan Admin"
